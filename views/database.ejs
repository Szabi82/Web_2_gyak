<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filmek és Mozik - Adatbázis</title>
    
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap" rel="stylesheet"> 
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Darkpan Sablon Stílusok -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
    <div class="container-fluid position-relative bg-white d-flex p-0">
        
        <!-- Bal oldali Sidebar / Menü -->
        <div class="sidebar bg-secondary pb-3">
            <nav class="navbar bg-secondary navbar-dark">
                <a href="/" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary"><i class="fa fa-film me-2"></i>Mozi Projekt</h3>
                </a>
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="/img/user.jpg" alt="" style="width: 40px; height: 40px;" onerror="this.style.display='none'">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0 text-white"><%= user ? user.username : 'Vendég' %></h6>
                        <span><%= user ? user.role : 'Látogató' %></span>
                    </div>
                </div>
                <div class="navbar-nav w-100">
                    <a href="/" class="nav-item nav-link"><i class="fa fa-home me-2"></i>Főoldal</a>
                    <a href="/database" class="nav-item nav-link active"><i class="fa fa-table me-2"></i>Adatbázis</a>
                    <% if (user && user.role === 'admin') { %>
                        <a href="/admin" class="nav-item nav-link"><i class="fa fa-tachometer-alt me-2"></i>Admin felület</a>
                    <% } %>
                </div>
            </nav>
        </div>
        <!-- Sidebar vége -->

        <!-- Tartalom konténer -->
        <div class="content w-100 bg-secondary" style="min-height: 100vh;">
            
            <!-- Navbar -->
            <nav class="navbar navbar-expand bg-secondary navbar-dark sticky-top px-4 py-0">
                <a href="#" class="sidebar-toggler flex-shrink-0 text-primary">
                    <i class="fa fa-bars"></i>
                </a>
                <div class="navbar-nav align-items-center ms-auto">
                    <% if (user) { %>
                        <a href="/logout" class="nav-link text-danger"><i class="fa fa-sign-out-alt me-2"></i>Kijelentkezés</a>
                    <% } else { %>
                        <a href="/login" class="nav-link text-light"><i class="fa fa-sign-in-alt me-2"></i>Bejelentkezés</a>
                    <% } %>
                </div>
            </nav>

            <!-- Adatok megjelenítése -->
            <div class="container-fluid pt-4 px-4">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="bg-secondary rounded h-100 p-4">
                            <h6 class="mb-4 text-primary fs-4">Adatbázis adatai (3 tábla struktúra)</h6>
                            <p class="text-white-50">A projekt filmjei, budapesti mozik és a hozzájuk tartozó vetítési kapcsolatok az adatbázisból.</p>

                            <!-- 1. Filmek táblázat -->
                            <h5 class="mt-5 text-light"><i class="fa fa-video me-2 text-primary"></i>Filmek (Movies)</h5>
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-bordered mt-2">
                                    <thead>
                                        <tr>
                                            <th>FKOD</th>
                                            <th>Film címe</th>
                                            <th>Szinkron</th>
                                            <th>Származás</th>
                                            <th>Műfaj</th>
                                            <th>Hossz</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% movies.forEach(movie => { %>
                                            <tr>
                                                <td><%= movie.fkod %></td>
                                                <td><%= movie.filmcim %></td>
                                                <td><%= movie.szinkron || '-' %></td>
                                                <td><%= movie.szarmazas %></td>
                                                <td><%= movie.mufaj %></td>
                                                <td><%= movie.hossz %> perc</td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- 2. Mozik táblázat -->
                            <h5 class="mt-5 text-light"><i class="fa fa-building me-2 text-primary"></i>Budapesti Mozik (Cinemas)</h5>
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-bordered mt-2">
                                    <thead>
                                        <tr>
                                            <th>Azonosító</th>
                                            <th>Mozi neve</th>
                                            <th>Irányítószám</th>
                                            <th>Cím</th>
                                            <th>Telefon</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% cinemas.forEach(cinema => { %>
                                            <tr>
                                                <td><%= cinema.moziazon %></td>
                                                <td><%= cinema.mozinev %></td>
                                                <td><%= cinema.irszam %></td>
                                                <td><%= cinema.cim %></td>
                                                <td><%= cinema.telefon || 'Nincs megadva' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- 3. Kapcsolatok táblázat -->
                            <h5 class="mt-5 text-light"><i class="fa fa-link me-2 text-primary"></i>Vetítési helyek / Kapcsolatok (Screenings)</h5>
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-bordered mt-2">
                                    <thead>
                                        <tr>
                                            <th>Film kód (fkod)</th>
                                            <th>Mozi azonosító (moziazon)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% screenings.forEach(sc => { %>
                                            <tr>
                                                <td><%= sc.fkod %></td>
                                                <td><%= sc.moziazon %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="container-fluid pt-4 px-4">
                <div class="bg-secondary rounded-top p-4 text-center text-muted">
                    <p class="mb-0">Bencze Szabolcs | Web-programozás II. Beadandó</p>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>