<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <title>Filmek és Mozik - Adatbázis</title>
    <!-- Bootstrap 5 CDN a szép reszponzív dizájnért -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

    <!-- Navigáció -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-danger" href="/">🎬 Mozi Projekt</a>
            <div>
                <a href="/" class="btn btn-outline-light btn-sm me-2">Főoldal</a>
                <% if (user) { %>
                    <a href="/logout" class="btn btn-danger btn-sm">Kijelentkezés</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-light btn-sm">Bejelentkezés</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <h2 class="mb-4 text-warning">Adatbázis adatai (3 tábla struktúra)</h2>
        <p class="text-muted">A projekt filmjei, budapesti mozik és a hozzájuk tartozó vetítési kapcsolatok az adatbázisból.</p>

        <!-- 1. Filmek táblázat -->
        <h3 class="mt-5 text-info">Filmek (Movies)</h3>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-bordered mt-2">
                <thead>
                    <tr>
                        <th>FKOD</th>
                        <th>Film címe</th>
                        <th>Szinkron</th>
                        <th>Származás</th>
                        <th>Műfaj</th>
                        <th>Hossz (perc)</th>
                    </tr>
                </thead>
                <tbody>
                    <% movies.forEach(movie => { %>
                        <tr>
                            <td><%= movie.fkod %></td>
                            <td><%= movie.filmcim %></td>
                            <td><%= movie.szinkron || '- ' %></td>
                            <td><%= movie.szarmazas %></td>
                            <td><%= movie.mufaj %></td>
                            <td><%= movie.hossz %> perc</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- 2. Mozik táblázat -->
        <h3 class="mt-5 text-info">Budapesti Mozik (Cinemas)</h3>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-bordered mt-2">
                <thead>
                    <tr>
                        <th>Azonosító</th>
                        <th>Mozi neve</th>
                        <th>Irányítószám</th>
                        <th>Cím</th>
                        <th>Telefon</th>
                    </tr>
                </thead>
                <tbody>
                    <% cinemas.forEach(cinema => { %>
                        <tr>
                            <td><%= cinema.moziazon %></td>
                            <td><%= cinema.mozinev %></td>
                            <td><%= cinema.irszam %></td>
                            <td><%= cinema.cim %></td>
                            <td><%= cinema.telefon || 'Nincs megadva' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- 3. Kapcsolatok (Helyek) táblázat -->
        <h3 class="mt-5 text-info">Vetítési helyek / Kapcsolatok (Screenings)</h3>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-bordered mt-2">
                <thead>
                    <tr>
                        <th>Film kód (fkod)</th>
                        <th>Mozi azonosító (moziazon)</th>
                    </tr>
                </thead>
                <tbody>
                    <% screenings.forEach(sc => { %>
                        <tr>
                            <td><%= sc.fkod %></td>
                            <td><%= sc.moziazon %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Footer a kötelező névvel / adatokkal -->
    <footer class="text-center py-4 text-muted border-top border-secondary mt-5">
        <p>Bencze Szabolcs | Web-programozás II. Beadandó</p>
    </footer>

</body>
</html>