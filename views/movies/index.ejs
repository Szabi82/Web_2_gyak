<%- include('../partials/header') %>

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary rounded h-100 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="mb-0">Filmek listája</h6>
            <a href="/movies/new" class="btn btn-sm btn-primary"><i class="fa fa-plus me-2"></i>Új film</a>
        </div>
        
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead>
                    <tr class="text-white">
                        <th>Kód</th>
                        <th>Cím</th>
                        <th>Színes</th>
                        <th>Szinkron</th>
                        <th>Származás</th>
                        <th>Műfaj</th>
                        <th>Hossz (p)</th>
                        <th>Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    <% movies.forEach(movie => { %>
                        <tr>
                            <td><%= movie.fkod %></td>
                            <td><%= movie.filmcim %></td>
                            <td><%= movie.szines %></td>
                            <td><%= movie.szinkron %></td>
                            <td><%= movie.szarmazas %></td>
                            <td><%= movie.mufaj %></td>
                            <td><%= movie.hossz %></td>
                            <td>
                                <a href="/movies/<%= movie._id %>/edit" class="btn btn-sm btn-warning me-1">Szerkesztés</a>
                                <form action="/movies/<%= movie._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Biztosan törlöd?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Törlés</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>