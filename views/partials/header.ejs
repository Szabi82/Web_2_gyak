<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mozi Projekt</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome a ikonokhoz -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Egyedi Darkpan stílusok -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-dark text-light">
    <div class="container-fluid position-relative bg-dark d-flex p-0">
        
        <!-- BAL OLDali SÁV (Sidebar) -->
        <div class="sidebar bg-black pe-4 pb-3" style="width: 250px; min-height: 100vh; position: fixed; top: 0; left: 0; z-index: 1000;">
            <nav class="navbar bg-black navbar-dark">
                <a href="/" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-danger"><i class="fa fa-film me-2"></i>Mozi Projekt</h3>
                </a>
                
                <!-- Felhasználói info -->
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="/img/user.jpg" alt="" style="width: 40px; height: 40px;">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0 text-light"><%= user ? user.username : 'Vendég' %></h6>
                        <span class="text-secondary small"><%= user ? (user.role == 'admin' ? 'Adminisztrátor' : 'Regisztrált látogató') : 'Látogató' %></span>
                    </div>
                </div>

                <!-- Menüpontok -->
                <div class="navbar-nav w-100">
                    <a href="/" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active text-danger' : '' %>"><i class="fa fa-tachometer-alt me-2"></i>Főoldal</a>
                    <a href="/database" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'database') ? 'active text-danger' : '' %>"><i class="fa fa-database me-2"></i>Adatbázis</a>
                    <a href="/diagram" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'diagram') ? 'active text-danger' : '' %>"><i class="fa fa-chart-bar me-2"></i>Diagram</a>
                    <a href="/contact" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'contact') ? 'active text-danger' : '' %>"><i class="fa fa-address-book me-2"></i>Kapcsolat</a>

                    <% if(user){ %>
                        <a href="/user" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'user') ? 'active text-danger' : '' %>"><i class="fa fa-envelope me-2"></i>Üzenetek</a>
                        <a href="/movies" class="nav-item nav-link"><i class="fa fa-film me-2"></i>Filmek kezelése</a>
                        
                    <% } %>

                    <% if(user && user.role=="admin"){ %>
                        <a href="/admin" class="nav-item nav-link <%= (typeof activePage !== 'undefined' && activePage === 'admin') ? 'active text-warning' : '' %>"><i class="fa fa-cogs me-2"></i>CRUD (Admin)</a>
                    <% } %>
                </div>
            </nav>
        </div>
        <!-- Sidebar vége -->

        <!-- JOBB OLDALI TARTALOM TERÜLET -->
        <div class="content" style="margin-left: 250px; width: calc(100% - 250px); min-height: 100vh; display: flex; flex-direction: column;">
            
            <!-- Felső sáv (Top Navbar) -->
            <nav class="navbar navbar-expand bg-black navbar-dark sticky-top px-4 py-0" style="height: 60px; border-bottom: 1px solid #333;">
                <div class="navbar-nav align-items-center ms-auto">
                    <% if(!user){ %>
                        <a href="/login" class="nav-link text-info me-3"><i class="fa fa-sign-in-alt me-1"></i>Bejelentkezés</a>
                        <a href="/register" class="btn btn-outline-danger btn-sm">Regisztráció</a>
                        <a href="/messages" class="nav-item nav-link"><i class="fa fa-envelope me-2"></i>Üzenetek</a>
                    <% } else { %>
                        <span class="text-secondary me-3">Üdv, <%= user.username %>!</span>
                        <a href="/logout" class="btn btn-outline-danger btn-sm"><i class="fa fa-sign-out-alt me-1"></i>Kijelentkezés</a>
                    <% } %>
                </div>
            </nav>
            <!-- Felső sáv vége -->

            <!-- Fő tartalom container -->
            <div class="container-fluid pt-4 px-4" style="flex: 1;">